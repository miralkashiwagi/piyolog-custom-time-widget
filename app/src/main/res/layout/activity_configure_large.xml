<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JSONのURL"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:hint="https://example.com/data.json" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="表示するtype名（最大3つ、空欄でその行は非表示）"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/type_input_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="type 1（例: Custom1）"
        android:text="Custom1"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/type_input_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="type 2（例: Pee）"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/type_input_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="type 3（例: Formula）" />

    <Button
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_gravity="end"
        android:text="保存" />

</LinearLayout>
</ScrollView>
